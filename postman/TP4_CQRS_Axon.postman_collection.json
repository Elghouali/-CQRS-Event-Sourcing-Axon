{
  "info": {
    "name": "TP4 CQRS Event Sourcing Axon",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requests ordered for the ENSET CQRS/Event Sourcing demo. Run #1 before others to save the accountId."
  },
  "item": [
    {
      "name": "1. Créer un compte (enregistre accountId)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"initialBalance\": 1000,\n  \"currency\": \"MAD\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('accountId', pm.response.json().accountId);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Crédit +500",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/credit",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 500\n}"
        }
      }
    },
    {
      "name": "3. Débit -200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/debit",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 200\n}"
        }
      }
    },
    {
      "name": "4. Lire le compte",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Solde = 1300', () => pm.expect(Number(pm.response.json().balance)).to.eql(1300));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Historique des événements",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/events"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('3 événements', () => pm.expect(pm.response.json().length).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Lister les comptes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts"
      }
    },
    {
      "name": "7. Test découvert (échec attendu)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/debit",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 5000\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Suspendre le compte",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"SUSPENDED\"\n}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accountId",
      "value": ""
    }
  ]
}